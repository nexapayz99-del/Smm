# ===== Telegram =====
API_ID=123456
API_HASH=your_api_hash_here
BOT_TOKEN=your_bot_token_here

# ===== MongoDB =====
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/?retryWrites=true&w=majority

# ===== Owner =====
OWNER_ID=123456789

# ===== Default Channels (comma-separated) =====
# These are auto-loaded on first boot if DB is empty
DEFAULT_CHANNELS=https://t.me/YourChannel1,https://t.me/YourChannel2

# ===== Polling / Timing =====
CHANNEL_POST_POLL_SECONDS=15
VC_LIVESTREAM_POLL_SECONDS=15
VC_JOIN_DELAY_SECONDS=7

# ===== Reaction fallback =====
DEFAULT_REACT_EMOJI=💘,💞,💗,💐,🥰,👍,🌷
